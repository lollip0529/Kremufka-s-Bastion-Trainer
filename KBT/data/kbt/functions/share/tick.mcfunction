execute as @a[scores={kbt.share=1..}] run function kbt:share/input
execute as @a[tag=kbt.share_user,tag=kbt.share_away] at @s unless entity @s[predicate=kbt:in_nether,scores={kbt.hp=1..},x=997,y=229,z=-1106,dx=10,dy=10,dz=10] run function kbt:share/booth/close
execute if score #sh_booth kbt.settings matches 1.. unless entity @a[tag=kbt.share_user] in minecraft:the_nether run function kbt:share/booth/clear
execute as @a[tag=kbt.share_user] unless score #sh_booth kbt.settings matches 1.. run function kbt:share/booth/close
execute if score #sh_active kbt.settings matches 1 in minecraft:the_nether unless block 1000 231 -1102 minecraft:structure_block as @a[tag=kbt.share_user,limit=1] run function kbt:share/booth/close
execute if score #sh_active kbt.settings matches 1 if score #sh_booth kbt.settings matches 2 in minecraft:the_nether if data block 1000 231 -1102 {sizeX:128,sizeY:128,sizeZ:128} as @a[tag=kbt.share_user,limit=1] run function kbt:share/import/blocks/begin
execute if score #sh_active kbt.settings matches 1 if score #sh_booth kbt.settings matches 2 in minecraft:the_nether unless data block 1000 231 -1102 {sizeX:1,sizeY:1,sizeZ:1} as @a[tag=kbt.share_user,limit=1] run function kbt:share/import/unsupported
execute if score #sh_active kbt.settings matches 1 if score #sh_booth kbt.settings matches 2 in minecraft:the_nether positioned 1000.5 229.5 -1101.5 if entity @e[type=minecraft:armor_stand,tag=kbt.share_route,distance=..0.6] as @a[tag=kbt.share_user,limit=1] run function kbt:share/import/found
execute if score #sh_active kbt.settings matches 1 if score #sh_booth kbt.settings matches 1 in minecraft:the_nether unless data block 1000 231 -1102 {mode:"SAVE",posX:0,posY:-2,posZ:0,sizeX:1,sizeY:1,sizeZ:1,ignoreEntities:0b} run data merge block 1000 231 -1102 {mode:"SAVE",posX:0,posY:-2,posZ:0,sizeX:1,sizeY:1,sizeZ:1,ignoreEntities:0b}
execute if score #sh_active kbt.settings matches 1 if score #sh_booth kbt.settings matches 2 in minecraft:the_nether unless data block 1000 231 -1102 {mode:"LOAD",posX:0,posY:-2,posZ:0,sizeX:1,sizeY:1,sizeZ:1,ignoreEntities:0b} run data merge block 1000 231 -1102 {mode:"LOAD",posX:0,posY:-2,posZ:0,sizeX:1,sizeY:1,sizeZ:1,ignoreEntities:0b}
execute if score #sh_work kbt.settings matches 1 unless score #rp_job kbt.settings matches 1 unless entity @a[tag=kbt.share_binder] run function kbt:share/import/cancel
